<?xml version='1.0' encoding='utf-8'?>
<Container version="2">
  <Name>Downrange-Local</Name>
  <Repository>downrange-local:0.3.0-alpha.2</Repository>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/spikked27/downrange/issues</Support>
  <Project>https://github.com/spikked27/downrange</Project>
  <Overview>Developer local-build fallback. For normal Unraid GUI updates use the registry template with ghcr.io/spikked27/downrange:latest instead. Source estimates are not confirmed trajectories. HTTPS is required for phone push.</Overview>
  <Category>Other:</Category>
  <WebUI>http://[IP]:[PORT:8097]/</WebUI>
  <Icon>https://raw.githubusercontent.com/spikked27/downrange/main/app/static/icon-192.png</Icon>
  <ExtraParams>--init</ExtraParams>
  <Config Name="WebUI port" Target="8097" Default="8097" Mode="tcp" Description="Host WebUI port." Type="Port" Display="always" Required="true" Mask="false">8097</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/downrange" Mode="rw" Description="Keep this mapping across updates." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/downrange</Config>
  <Config Name="Administrator password" Target="ADMIN_PASSWORD" Default="" Mode="" Description="12+ characters, initial account creation only." Type="Variable" Display="always" Required="false" Mask="true" />
  <Config Name="HTTPS public address" Target="PUBLIC_URL" Default="" Mode="" Description="Exact HTTPS origin; no subpath." Type="Variable" Display="always" Required="false" Mask="false" />
  <Config Name="Time zone" Target="TZ" Default="America/New_York" Mode="" Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
  <Config Name="User ID" Target="PUID" Default="99" Mode="" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="Group ID" Target="PGID" Default="100" Mode="" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="Automatic trajectory sources" Target="SOURCES_ENABLED" Default="true" Mode="" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Flight Club API key (optional)" Target="FLIGHTCLUB_API_KEY" Default="" Mode="" Type="Variable" Display="advanced" Required="false" Mask="true" />
  <Config Name="Registration invitation code" Target="REGISTRATION_CODE" Default="" Mode="" Type="Variable" Display="advanced" Required="false" Mask="true" />
  <Config Name="Launch Library API token" Target="LL2_API_KEY" Default="" Mode="" Type="Variable" Display="advanced" Required="false" Mask="true" />
</Container>
