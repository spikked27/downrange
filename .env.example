# Copy to .env for Docker Compose. Never commit the real .env file.
APPDATA=/mnt/user/appdata/downrange
WEB_PORT=8097
PUID=99
PGID=100
TZ=America/New_York
# Set a 12+ character bootstrap password, or leave blank for one-time generation in logs.
ADMIN_PASSWORD=
# Required for phone web push. HTTPS origin only, no trailing path.
PUBLIC_URL=
# Optional 16+ character invitation code; blank disables new-user registration.
REGISTRATION_CODE=
# Optional contact if PUBLIC_URL is set. Otherwise use mailto:you@example.com.
VAPID_SUBJECT=
# Optional Launch Library 2 token; free access works without it.
LL2_API_KEY=
