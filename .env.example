# Docker Compose only. Never commit real credentials.
APPDATA=/mnt/user/appdata/downrange
WEB_PORT=8097
PUID=99
PGID=100
TZ=America/New_York
# 12+ characters; used only when an account is first created.
ADMIN_PASSWORD=
# Exact HTTPS origin; keep the working address when updating.
PUBLIC_URL=
REGISTRATION_CODE=
VAPID_SUBJECT=
LL2_API_KEY=
SOURCES_ENABLED=true
# Optional licensed simulation API; public sources work without it.
FLIGHTCLUB_API_KEY=
